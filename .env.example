# OpenRouter key used by Jev and, by default, the text helper.
OPENROUTER_API_KEY=

# Jev uses OpenRouter's Decisions API.
JEV_MODEL=~typesafe/jev-latest
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# Optional separate credential for TYPE_TEXT.
# Leave empty to reuse OPENROUTER_API_KEY.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
